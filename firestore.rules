rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dono autenticado: UID conferente + e-mail verificado.
    function isVerifiedOwner(userId) {
      return request.auth != null
             && request.auth.uid == userId
             && request.auth.token.email_verified == true;
    }

    // Valida formato e tamanho do documento principal de dados.
    // Em writes com merge, request.resource.data é o documento COMPLETO já
    // mesclado (dados existentes + alterações), então checar os campos
    // presentes é seguro e não bloqueia gravações parciais legítimas.
    function isValidMainDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['purchases', 'sales', 'returns', 'settings', 'metadata'])
             && (!('purchases' in d) || (d.purchases is list && d.purchases.size() <= 20000))
             && (!('sales' in d)     || (d.sales is list     && d.sales.size() <= 40000))
             && (!('returns' in d)   || (d.returns is list   && d.returns.size() <= 40000))
             && (!('settings' in d)  || d.settings is map)
             && (!('metadata' in d)  || d.metadata is map);
    }

    // Análises salvas da calculadora. Documento próprio para não disputar
    // gravação com o documento principal.
    function isValidAnalysesDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['analyses', 'metadata'])
             && (!('analyses' in d) || (d.analyses is list && d.analyses.size() <= 2000))
             && (!('metadata' in d) || d.metadata is map);
    }

    // Documento principal de dados. Caminho fixo, como sempre foi.
    //
    // A partir do schema 2 ele guarda apenas `settings` e `metadata`: o razão
    // mudou para as subcoleções abaixo. Os arrays continuam ACEITOS aqui porque
    // a migração é aditiva — enquanto houver base sem migrar, este documento
    // ainda é a fonte, e o limite de 1 MiB do Firestore continua valendo para
    // ela (era essa parede, por volta de 1.500 a 2.500 vendas, que motivou a
    // mudança).
    match /users/{userId}/db/main {
      allow read:           if isVerifiedOwner(userId);
      allow create, update: if isVerifiedOwner(userId) && isValidMainDoc();
      allow delete:         if isVerifiedOwner(userId);
    }

    // ── Razão em subcoleções (schema 2) ──────────────────────────────────
    //
    // Um documento por registro tira o teto de 1 MiB do caminho, torna a
    // escrita incremental (antes QUALQUER alteração regravava a base inteira)
    // e — o que mais importa — permite que a Cloud Function escreva no razão
    // sem correr o risco de ser sobrescrita pela próxima gravação do navegador.
    //
    // O tamanho é limitado por documento, não por coleção: contar documentos
    // numa rule custaria uma leitura por gravação, e o teto real agora é o da
    // conta, não o do Firestore.

    function campoTexto(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }

    function isValidLancamento() {
      let d = request.resource.data;
      return d.keys().size() <= 40
             && d.id is string && d.id.size() > 0 && d.id.size() <= 64
             && campoTexto(d, 'product', 300)
             && campoTexto(d, 'notes', 2000)
             && campoTexto(d, 'externalId', 200);
    }

    match /users/{userId}/purchases/{purchaseId} {
      allow read:   if isVerifiedOwner(userId);
      allow write:  if isVerifiedOwner(userId)
                    && (request.method == 'delete' || isValidLancamento());
    }
    match /users/{userId}/sales/{saleId} {
      allow read:   if isVerifiedOwner(userId);
      allow write:  if isVerifiedOwner(userId)
                    && (request.method == 'delete' || isValidLancamento());
    }
    match /users/{userId}/returns/{returnId} {
      allow read:   if isVerifiedOwner(userId);
      allow write:  if isVerifiedOwner(userId)
                    && (request.method == 'delete' || isValidLancamento());
    }

    // Estado da integração com o Mercado Livre (nickname, cursores, último
    // sync, erros). Só o servidor escreve, via Admin SDK.
    match /users/{userId}/db/ml {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }

    // Análises da calculadora: gravadas pelo próprio app.
    match /users/{userId}/db/analyses {
      allow read:           if isVerifiedOwner(userId);
      allow create, update: if isVerifiedOwner(userId) && isValidAnalysesDoc();
      allow delete:         if isVerifiedOwner(userId);
    }

    // Dados trazidos do Mercado Livre. O app lê para exibir; quem escreve é
    // sempre o servidor (o Admin SDK ignora estas regras).
    match /users/{userId}/mlItems/{itemId} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/mlLinks/{itemId} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/mlInbox/{docId} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/mlReturns/{docId} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/mlBilling/{periodo} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/mlPayouts/{orderId} {
      allow read:  if isVerifiedOwner(userId);
      allow write: if false;
    }

    // Nega qualquer outro caminho explicitamente. Cobre, entre outros:
    //   users/{uid}/secret/ml     tokens do Mercado Livre
    //   users/{uid}/mlOrders/*    payloads crus (auditoria)
    //   users/{uid}/mlEvents/*    fila do webhook
    //   mlIndex/*                 mapeamento user_id do ML -> uid
    // Nenhum deles é legível pelo navegador em hipótese alguma.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
