{
  "name": "ml-gestao",
  "version": "1.0.0",
  "description": "Lucrato — painel financeiro do revendedor. Angular 18 + design system próprio.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "prebuild": "node scripts/gerar-versao-csp.mjs",
    "build": "ng build",
    "prebuild:staging": "node scripts/gerar-versao-csp.mjs",
    "build:staging": "ng build --configuration staging",
    "start:staging": "ng serve -o --configuration staging",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "pretest": "node scripts/gerar-versao-csp.mjs",
    "test": "jest",
    "smoke": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build:ext": "tsc -p extension --noEmit && node extension/build.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-lucrato \"npm --prefix functions run test:rules\"",
    "build:ext:prod": "tsc -p extension --noEmit && node extension/build.mjs --producao",
    "test:functions": "npm --prefix functions test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/cdk": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/fire": "^18.0.1",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@angular/service-worker": "^18.2.14",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "chart.js": "^4.4.4",
    "firebase": "^10.14.1",
    "ng2-charts": "^6.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.6.2",
    "lucide-static": "^1.23.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.5.2"
  }
}
