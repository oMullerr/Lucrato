# Configuracao NAO secreta das functions no projeto de testes.
# Os segredos (ML_CLIENT_ID/ML_CLIENT_SECRET) ficam no Secret Manager.

# Precisa ser identica a cadastrada no DevCenter do Mercado Livre.
ML_REDIRECT_URI=https://southamerica-east1-lucrato-dev.cloudfunctions.net/mlAuthCallback

# Origens extras aceitas no retorno, separadas por virgula.
# localhost e *.vercel.app ja sao aceitos por padrao.
APP_ORIGINS=
