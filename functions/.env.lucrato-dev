# Configuracao NAO secreta das functions no projeto de testes.
# Os segredos (ML_CLIENT_ID/ML_CLIENT_SECRET) ficam no Secret Manager.

# Precisa ser identica a cadastrada no DevCenter do Mercado Livre.
ML_REDIRECT_URI=https://southamerica-east1-lucrato-dev.cloudfunctions.net/mlAuthCallback

# Origens extras aceitas no retorno, separadas por virgula.
# localhost e *.vercel.app ja sao aceitos por padrao.
APP_ORIGINS=http://localhost:4200

# Cifra dos tokens do Mercado Livre com Cloud KMS. VAZIO = desligado, tokens
# em texto puro (comportamento de sempre). Preencher e caminho de IDA: as
# functions antigas nao sabem decifrar o que for gravado com prefixo kms1:.
ML_KMS_KEY=

# Segredo no caminho do webhook (/mlWebhook/<token>), que precisa ser
# cadastrado igual no DevCenter. VAZIO = webhook aberto, como sempre foi.
#
# ATENCAO: ESTE ARQUIVO E VERSIONADO. Preenchido, este valor VIRA SEGREDO e
# nao pode ficar aqui - vai para o Secret Manager, como ML_CLIENT_SECRET.
# ML_REDIRECT_URI, APP_ORIGINS e ML_KMS_KEY nao sao segredos e podem ficar.
ML_WEBHOOK_TOKEN=