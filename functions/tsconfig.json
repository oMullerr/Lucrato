{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "moduleResolution": "node",
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "../src/app/core/models/models.ts",
    "../src/app/core/fiscal/fiscal.model.ts",
    "../src/app/core/ml/matching.ts",
    "../src/app/core/ml/order-mapping.ts",
    "../src/app/core/ml/returns-apply.ts"
  ],
  "exclude": [
    "lib",
    "node_modules",
    "**/*.spec.ts"
  ]
}
