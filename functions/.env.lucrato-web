# Configuracao NAO secreta das functions em PRODUCAO.
# Os segredos (ML_CLIENT_ID/ML_CLIENT_SECRET) ficam no Secret Manager.

# Precisa ser identica a cadastrada no DevCenter do Mercado Livre, no
# aplicativo de PRODUCAO (nao no de testes).
ML_REDIRECT_URI=https://southamerica-east1-lucrato-web.cloudfunctions.net/mlAuthCallback

# Origens extras aceitas no retorno, separadas por virgula.
# localhost e *.vercel.app ja sao aceitos por padrao; preencha aqui somente se
# a producao usar dominio proprio (ex.: https://app.lucrato.com.br).
APP_ORIGINS=
